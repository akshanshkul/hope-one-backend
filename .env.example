NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# Firebase Admin credentials (server-side only; never expose these to the frontend).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Prefer the Supabase IPv4-compatible pooler connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSL=true

MAIL_API_HOST=api.zeptomail.in
MAIL_API_TOKEN=Zoho-enczapikey replace-with-your-token
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Onco Sahayak
# Public HTTPS URL for the logo shown in registration emails.
MAIL_LOGO_URL=https://your-domain.com/logo-lockup.png

AWS_S3_ACCESS_KEY_ID=replace-with-rotated-access-key
AWS_S3_SECRET_ACCESS_KEY=replace-with-rotated-secret-key
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=hope-care